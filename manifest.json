{
  "manifest_version": 3,
  "name": "Coding Agents Usage",
  "version": "1.0.1",
  "description": "See remaining usage for Claude Code, Codex, Grok Build and Cursor at a glance.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coding Agents Usage",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://grok.com/*",
    "https://cursor.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://grok.com/*",
        "https://cursor.com/*"
      ],
      "js": ["parse.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
