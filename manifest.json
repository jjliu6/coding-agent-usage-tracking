{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "1.3.0",
  "description": "__MSG_extDesc__",
  "action": {
    "default_title": "__MSG_extName__",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "tabs", "sidePanel", "alarms", "notifications"],
  "side_panel": { "default_path": "popup.html" },
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://grok.com/*",
    "https://cursor.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://grok.com/*",
        "https://cursor.com/*"
      ],
      "js": ["parse.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
